Windows Registry Editor Version 5.00

; ================================================================
; YAZX Network Registry Tweaks
; Made by YAZX
; TCP/IP, Nagle, Network adapter optimization
; ================================================================

; --- TCP/IP Parameters ---
[HKEY_LOCAL_MACHINE\SYSTEM\CurrentControlSet\Services\Tcpip\Parameters]
"DefaultTTL"=dword:00000040
"TcpMaxDataRetransmissions"=dword:00000005
"Tcp1323Opts"=dword:00000001
"MaxUserPort"=dword:0000fffe
"TcpTimedWaitDelay"=dword:0000001e
"GlobalMaxTcpWindowSize"=dword:00007fff
"EnablePMTUDiscovery"=dword:00000001
"EnablePMTUBHDetect"=dword:00000000
"SackOpts"=dword:00000001

; --- AFD (Ancillary Function Driver - Winsock) ---
[HKEY_LOCAL_MACHINE\SYSTEM\CurrentControlSet\Services\AFD\Parameters]
"DefaultReceiveWindow"=dword:00010000
"DefaultSendWindow"=dword:00010000
"FastSendDatagramThreshold"=dword:00000400
"EnableDynamicBacklog"=dword:00000001
"MinimumDynamicBacklog"=dword:00000020
"MaximumDynamicBacklog"=dword:00020000
"DynamicBacklogGrowthDelta"=dword:0000000a

; --- Disable Nagle Algorithm (per-interface - applied by script) ---
; Note: Nagle must be set on the specific interface subkey
; This is handled by module 07 script

; --- QoS / Throttle ---
[HKEY_LOCAL_MACHINE\SOFTWARE\Policies\Microsoft\Windows\Psched]
"NonBestEffortLimit"=dword:00000000

; --- Disable Network Power Management ---
[HKEY_LOCAL_MACHINE\SYSTEM\CurrentControlSet\Services\Tcpip\Parameters]
"DisableTaskOffload"=dword:00000000
"EnableTCPA"=dword:00000000

; --- DNS Client Optimization ---
[HKEY_LOCAL_MACHINE\SYSTEM\CurrentControlSet\Services\Dnscache\Parameters]
"NegativeCacheTime"=dword:00000000
"NetFailureCacheTime"=dword:00000000
"NegativeSOACacheTime"=dword:00000000
